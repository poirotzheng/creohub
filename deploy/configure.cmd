@echo off
rem =====================================================================
rem configure.cmd - create <repo>\local.env with CREO_TOOLKIT_ROOT.
rem
rem Usage:
rem   deploy\configure.cmd                 interactive
rem   deploy\configure.cmd --check         print current resolution
rem   set CREO_TOOLKIT_ROOT=... ^& deploy\configure.cmd   non-interactive
rem
rem The generated local.env is git-ignored.
rem NOTE: this file MUST stay CRLF + pure ASCII.
rem =====================================================================
setlocal
set "ROOT=%~dp0.."

if /i "%~1"=="--check" goto :check

if defined CREO_TOOLKIT_ROOT set "PTK=%CREO_TOOLKIT_ROOT%" & goto :write

echo creo-hub build environment
echo.
echo Enter the Pro/TOOLKIT SDK directory (the one containing includes\ProToolkit.h).
echo Example: C:\Program Files\PTC\Creo 6.0.0.0\Common Files\protoolkit
echo.
set "PTK="
set /p "PTK=Path: "
if not defined PTK goto :cancelled

:write
if not exist "%PTK%\includes\ProToolkit.h" goto :bad_path
> "%ROOT%\local.env" echo # generated by deploy\configure.cmd
>> "%ROOT%\local.env" echo CREO_TOOLKIT_ROOT=%PTK%
echo [i] wrote %ROOT%\local.env
call "%~dp0local_env.cmd"
if errorlevel 1 exit /b 2
echo [i] PTK resolved: %PTK%
exit /b 0

:bad_path
echo [ERR] not a Pro/TOOLKIT root (missing includes\ProToolkit.h): %PTK%
exit /b 2

:cancelled
echo [i] cancelled
exit /b 1

:check
if exist "%ROOT%\local.env" (
  echo [i] local.env:
  type "%ROOT%\local.env"
) else (
  echo [i] local.env not found
)
call "%~dp0local_env.cmd"
if errorlevel 1 ( echo [i] PTK NOT resolved & exit /b 1 )
echo [i] PTK resolved: %PTK%
exit /b 0
