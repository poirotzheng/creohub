# Normalize text, keep Windows scripts CRLF, mark binaries.
* text=auto eol=lf

*.cmd        text eol=crlf
*.bat        text eol=crlf
*.ps1        text eol=crlf
*.iss        text eol=crlf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.mjs        text eol=lf
*.c          text eol=lf
*.h          text eol=lf
*.def        text eol=lf

*.dll        binary
*.lib        binary
*.exp        binary
*.obj        binary
*.pdb        binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.zip        binary
*.exe        binary
